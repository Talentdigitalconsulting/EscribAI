# ConsteAi — configuración del servidor (Apache / LiteSpeed en Hostinger)

# ---------- siempre HTTPS y sin www ----------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://consteai.es%{REQUEST_URI} [L,R=301]

# La raíz del dominio es la web de venta; la app vive en index.html.
RewriteRule ^$ /venta.html [L]

# ---------- tipos de archivo ----------
AddType application/manifest+json .webmanifest .json
AddType application/javascript .js
AddCharset UTF-8 .html .js .json .css .txt .md

# ---------- cabeceras de seguridad ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
  # El service worker puede controlar todo el sitio
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
  </Files>

  # ---------- caché ----------
  # Lo que cambia con cada mejora: nunca cachear en el navegador
  <FilesMatch "\.(html|js|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Iconos e imágenes: un año
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------- compresión ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------- nada de listados ni archivos de trabajo ----------
Options -Indexes
<FilesMatch "\.(md|bat|sql|ts|txt~|bak)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(robots\.txt|ads\.txt)$">
  Require all granted
</FilesMatch>

ErrorDocument 404 /venta.html
